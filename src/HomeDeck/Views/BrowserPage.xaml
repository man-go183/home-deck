<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ctrl="clr-namespace:HomeDeck.Controls"
             x:Class="HomeDeck.Views.BrowserPage"
             Title="Home Deck"
             BackgroundColor="{StaticResource HdBg}">
  <Grid RowDefinitions="40,*">
    <!-- title-bar row. On Windows this grid IS the OS title-bar content
         (see BrowserPage.Windows.cs); on Android it is hidden and the pill
         moves into the native toolbar title view. -->
    <Grid x:Name="TitleBar" Grid.Row="0" ColumnDefinitions="40,*,140"
          Padding="4,0,0,0" BackgroundColor="#241F1A">
      <Button x:Name="BackBtn" Text="‹" FontSize="18" WidthRequest="40"
              TextColor="{StaticResource HdText}" BackgroundColor="Transparent"
              VerticalOptions="Center" Clicked="OnBack" />
      <HorizontalStackLayout x:Name="Pill" Grid.Column="1" Spacing="8"
                             VerticalOptions="Center" HorizontalOptions="Center">
        <Grid WidthRequest="26" HeightRequest="26" VerticalOptions="Center">
          <Ellipse x:Name="PillAva" Fill="#B3402E" />
          <Label x:Name="PillGlyph" FontSize="12" FontAttributes="Bold"
                 TextColor="White" HorizontalOptions="Center"
                 VerticalOptions="Center" />
          <Path x:Name="PillShield" WidthRequest="12" HeightRequest="14"
                Aspect="None" TranslationX="1" TranslationY="1"
                Data="M6 0 L11 2.5 V7 C11 10.5 8.7 12.3 6 13.5 C3.3 12.3 1 10.5 1 7 V2.5 Z"
                Fill="{StaticResource HdGold}"
                Stroke="{StaticResource HdGoldDeep}" StrokeThickness="1"
                HorizontalOptions="End" VerticalOptions="End" />
        </Grid>
        <Label x:Name="PillName" FontSize="14" FontAttributes="Bold"
               TextColor="{StaticResource HdText}" VerticalOptions="Center" />
        <Label Text="– Home Deck" FontSize="12"
               TextColor="{StaticResource HdDim}" VerticalOptions="Center" />
        <Label.GestureRecognizers>
          <TapGestureRecognizer Tapped="OnPillTap" />
        </Label.GestureRecognizers>
      </HorizontalStackLayout>
      <!-- caption-button reserve (Windows min/max/close overlay this area) -->
      <BoxView Grid.Column="2" Color="Transparent" />
    </Grid>

    <Grid Grid.Row="1">
      <ctrl:ShellWebView x:Name="Web" />
      <!-- launch splash -->
      <Grid x:Name="Splash" BackgroundColor="{StaticResource HdBg}"
            VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand">
        <VerticalStackLayout VerticalOptions="Center" Spacing="12">
          <Grid WidthRequest="76" HeightRequest="76" HorizontalOptions="Center">
            <Ellipse x:Name="SplashAva" Fill="#B3402E" />
            <Label x:Name="SplashGlyph" FontSize="30" FontAttributes="Bold"
                   TextColor="White" HorizontalOptions="Center"
                   VerticalOptions="Center" />
          </Grid>
          <Label x:Name="SplashName" FontSize="17" FontAttributes="Bold"
                 TextColor="{StaticResource HdText}"
                 HorizontalOptions="Center" />
        </VerticalStackLayout>
      </Grid>
      <!-- profile switcher dropdown -->
      <Border x:Name="Drop" IsVisible="false"
              BackgroundColor="#1E1A16" Stroke="#3A342D"
              HorizontalOptions="Center" VerticalOptions="Start"
              Margin="0,8,0,0" Padding="6" MinimumWidthRequest="220">
        <Border.StrokeShape>
          <RoundRectangle CornerRadius="14" />
        </Border.StrokeShape>
        <VerticalStackLayout x:Name="DropList" Spacing="2" />
      </Border>
    </Grid>
  </Grid>
</ContentPage>
