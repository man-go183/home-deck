<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ctrl="clr-namespace:HomeDeck.Controls"
             x:Class="HomeDeck.Views.BrowserPage"
             Title="Home Deck"
             BackgroundColor="{StaticResource HdBg}">
  <Grid RowDefinitions="40,*">
    <!-- title-bar row. On Windows this grid IS the OS title-bar content
         (see BrowserPage.Windows.cs); on Android it is hidden and the pill
         moves into the native toolbar title view. -->
    <Grid x:Name="TitleBar" Grid.Row="0" ColumnDefinitions="40,*,40,140"
          Padding="4,0,0,0" BackgroundColor="#000000">
      <Button x:Name="BackBtn" Text="‹" FontSize="18" WidthRequest="40"
              TextColor="{StaticResource HdText}" BackgroundColor="Transparent"
              VerticalOptions="Center" Clicked="OnBack" />
      <HorizontalStackLayout x:Name="Pill" Grid.Column="1" Spacing="8"
                             VerticalOptions="Center" HorizontalOptions="Center">
        <Grid WidthRequest="26" HeightRequest="26" VerticalOptions="Center">
          <Grid x:Name="PillAvaBox" WidthRequest="26" HeightRequest="26" />
          <Path x:Name="PillShield" WidthRequest="13" HeightRequest="13"
                Aspect="Uniform" TranslationX="1" TranslationY="1"
                Data="M12 3l7 2.8v5.1c0 4.6-3 7.9-7 9.6-4-1.7-7-5-7-9.6V5.8z"
                Fill="{StaticResource HdGold}"
                Stroke="{StaticResource HdGoldDeep}" StrokeThickness="1.5"
                HorizontalOptions="End" VerticalOptions="End" />
          <Path x:Name="PillSlash" WidthRequest="13" HeightRequest="13"
                Aspect="Uniform" TranslationX="1" TranslationY="1"
                Data="M5 5l14 14" Stroke="{StaticResource HdDim}"
                StrokeThickness="2" IsVisible="false"
                HorizontalOptions="End" VerticalOptions="End" />
        </Grid>
        <Label x:Name="PillName" FontSize="14" FontAttributes="Bold"
               TextColor="{StaticResource HdText}" VerticalOptions="Center" />
        <Label Text="– Home Deck" FontSize="12"
               TextColor="{StaticResource HdDim}" VerticalOptions="Center" />
        <Label.GestureRecognizers>
          <TapGestureRecognizer Tapped="OnPillTap" />
        </Label.GestureRecognizers>
      </HorizontalStackLayout>
      <!-- icon-only reload, beside the pill (no text) -->
      <Grid x:Name="ReloadBtn" Grid.Column="2" WidthRequest="40"
            VerticalOptions="FillAndExpand" HorizontalOptions="Center">
        <Path Data="M23 4v6h-6 M20.49 15a9 9 0 1 1-2.12-9.36L23 10"
              Stroke="{StaticResource HdDim}" StrokeThickness="1.8"
              StrokeLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"
              WidthRequest="16" HeightRequest="16" Aspect="Uniform"
              HorizontalOptions="Center" VerticalOptions="Center" />
        <Grid.GestureRecognizers>
          <TapGestureRecognizer Tapped="OnReload" />
        </Grid.GestureRecognizers>
      </Grid>
      <!-- caption-button reserve (Windows min/max/close overlay this area) -->
      <BoxView Grid.Column="3" Color="Transparent" />
    </Grid>

    <Grid Grid.Row="1">
      <ctrl:ShellWebView x:Name="Web" />
      <!-- launch splash -->
      <Grid x:Name="Splash" BackgroundColor="{StaticResource HdBg}"
            VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand">
        <VerticalStackLayout VerticalOptions="Center" Spacing="12">
          <Grid WidthRequest="76" HeightRequest="76" HorizontalOptions="Center"
                x:Name="SplashAvaBox" />
          <Label x:Name="SplashName" FontSize="17" FontAttributes="Bold"
                 TextColor="{StaticResource HdText}"
                 HorizontalOptions="Center" />
          <Label x:Name="SplashStatus" FontSize="11"
                 TextColor="{StaticResource HdDim}"
                 HorizontalOptions="Center" IsVisible="false" />
          <Label x:Name="SplashError" FontSize="13"
                 TextColor="{StaticResource HdGold}"
                 HorizontalOptions="Center" HorizontalTextAlignment="Center"
                 Margin="24,4,24,0" IsVisible="false" />
          <Button x:Name="SplashRetry" Text="Try again" IsVisible="false"
                  BackgroundColor="{StaticResource HdGold}" TextColor="#161311"
                  CornerRadius="10" HorizontalOptions="Center"
                  Clicked="OnSplashRetry" />
        </VerticalStackLayout>
      </Grid>
      <!-- profile switcher dropdown -->
      <Border x:Name="Drop" IsVisible="false"
              BackgroundColor="#000000" Stroke="#3A342D"
              HorizontalOptions="Start" VerticalOptions="Start"
              Margin="48,8,0,0" Padding="6" MinimumWidthRequest="220">
        <Border.StrokeShape>
          <RoundRectangle CornerRadius="14" />
        </Border.StrokeShape>
        <VerticalStackLayout x:Name="DropList" Spacing="2" />
      </Border>
      <!-- adblock settings panel -->
      <BoxView x:Name="AdsDim" IsVisible="false" Color="#80000000"
               HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
        <BoxView.GestureRecognizers>
          <TapGestureRecognizer Tapped="OnAdsDimTap" />
        </BoxView.GestureRecognizers>
      </BoxView>
      <Border x:Name="AdsPanel" IsVisible="false"
              BackgroundColor="#000000" Stroke="#3A342D"
              HorizontalOptions="Center" VerticalOptions="Center"
              Padding="18" MaximumWidthRequest="420" MaximumHeightRequest="520">
        <Border.StrokeShape>
          <RoundRectangle CornerRadius="14" />
        </Border.StrokeShape>
        <ScrollView>
          <VerticalStackLayout x:Name="AdsPanelBody" Spacing="8" />
        </ScrollView>
      </Border>
      <!-- native pick-mode exit: lives outside the page, always clickable
           even when focus is buried in a fullscreen frame -->
      <Button x:Name="PickCancelBtn" Text="✕ Cancel picking" IsVisible="false"
              BackgroundColor="#161311" TextColor="{StaticResource HdGold}"
              BorderColor="{StaticResource HdGold}" BorderWidth="1"
              CornerRadius="14" FontSize="13" Padding="14,7" Margin="0,8,0,0"
              HorizontalOptions="Center" VerticalOptions="Start"
              Clicked="OnPickCancel" />
    </Grid>
  </Grid>
</ContentPage>
