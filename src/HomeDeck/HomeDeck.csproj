<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>HomeDeck</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>Home Deck</ApplicationTitle>
    <ApplicationId>com.homedeck.shell</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Plugin.LocalNotification" Version="11.1.0" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.110" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <Content Include="Platforms\Windows\Assets\*.png" />
    <MauiXaml Remove="Platforms\Windows\App.xaml" />
    <!-- WMI brightness control (internal displays) -->
    <PackageReference Include="System.Management" Version="9.0.0" />
    <!-- hdblock native blocker, built by CI (see windows.yml). Missing file = blocking off, build still works. -->
    <Content Include="runtimes\win-x64\native\hdblock.dll" Condition="Exists('runtimes\win-x64\native\hdblock.dll')" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <!-- Same deal: CI-built .so files, gitignored. Absent = blocking off. -->
    <AndroidNativeLibrary Include="runtimes\android-arm64\native\libhdblock.so" Abi="arm64-v8a" Condition="Exists('runtimes\android-arm64\native\libhdblock.so')" />
    <AndroidNativeLibrary Include="runtimes\android-x64\native\libhdblock.so" Abi="x86_64" Condition="Exists('runtimes\android-x64\native\libhdblock.so')" />
  </ItemGroup>

  <!-- v1 ships no custom icon/splash assets on purpose (see README).
       Add later with:
         <MauiIcon Include="Resources\AppIcon\appicon.svg" />
         <MauiSplashScreen Include="Resources\Splash\splash.svg" /> -->

  <ItemGroup>
    <!-- Bundled web bootstrap + default profile seed -->
    <MauiAsset Include="Web\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    <MauiAsset Include="profiles.default.json" LogicalName="profiles.default.json" />
  </ItemGroup>

</Project>
